# Complete, pinned vector library. Installation never downloads resources.
set(NOVA_ICON_ARCHIVE "${CMAKE_CURRENT_LIST_DIR}/../assets/icon-library.tar.xz")
set(NOVA_ICON_METADATA "${CMAKE_CURRENT_LIST_DIR}/../assets/icon-library.json")
file(READ "${NOVA_ICON_METADATA}" NOVA_ICON_JSON)
string(JSON NOVA_ICON_EXPECTED_SHA GET "${NOVA_ICON_JSON}" archiveSha256)
file(SHA256 "${NOVA_ICON_ARCHIVE}" NOVA_ICON_ACTUAL_SHA)
if(NOT NOVA_ICON_ACTUAL_SHA STREQUAL NOVA_ICON_EXPECTED_SHA)
    message(FATAL_ERROR "Icon library checksum mismatch")
endif()
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
    "${NOVA_ICON_ARCHIVE}" "${NOVA_ICON_METADATA}")
set(NOVA_GOLDEN_ARCHIVE "${CMAKE_CURRENT_LIST_DIR}/../assets/goldengate-library.tar.xz")
set(NOVA_GOLDEN_METADATA "${CMAKE_CURRENT_LIST_DIR}/../assets/goldengate-library.json")
file(READ "${NOVA_GOLDEN_METADATA}" NOVA_GOLDEN_JSON)
string(JSON NOVA_GOLDEN_EXPECTED_SHA GET "${NOVA_GOLDEN_JSON}" archiveSha256)
file(SHA256 "${NOVA_GOLDEN_ARCHIVE}" NOVA_GOLDEN_SHA)
if(NOT NOVA_GOLDEN_SHA STREQUAL NOVA_GOLDEN_EXPECTED_SHA)
    message(FATAL_ERROR "GoldenGate library checksum mismatch")
endif()
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
    "${NOVA_GOLDEN_ARCHIVE}" "${NOVA_GOLDEN_METADATA}")
set(NOVA_ICON_COMBINED_SHA "${NOVA_ICON_ACTUAL_SHA}:${NOVA_GOLDEN_SHA}")
set(NOVA_ICON_LIBRARY_DIR "${CMAKE_BINARY_DIR}/icon-library")
set(NOVA_ICON_STAMP "${CMAKE_BINARY_DIR}/icon-library.sha256")
set(NOVA_ICON_PREVIOUS_SHA "")
if(EXISTS "${NOVA_ICON_STAMP}")
    file(READ "${NOVA_ICON_STAMP}" NOVA_ICON_PREVIOUS_SHA)
endif()
if(NOT NOVA_ICON_PREVIOUS_SHA STREQUAL NOVA_ICON_COMBINED_SHA
        OR NOT EXISTS "${NOVA_ICON_LIBRARY_DIR}/NovaGlass-System/index.theme"
        OR NOT EXISTS "${NOVA_ICON_LIBRARY_DIR}/NovaGlass-GoldenGate-light/index.theme")
    file(REMOVE_RECURSE "${NOVA_ICON_LIBRARY_DIR}")
    file(ARCHIVE_EXTRACT INPUT "${NOVA_ICON_ARCHIVE}" DESTINATION "${NOVA_ICON_LIBRARY_DIR}")
    file(ARCHIVE_EXTRACT INPUT "${NOVA_GOLDEN_ARCHIVE}" DESTINATION "${NOVA_ICON_LIBRARY_DIR}")
    file(WRITE "${NOVA_ICON_STAMP}" "${NOVA_ICON_COMBINED_SHA}")
endif()
include(GNUInstallDirs)
install(DIRECTORY "${NOVA_ICON_LIBRARY_DIR}/" DESTINATION "${CMAKE_INSTALL_DATADIR}/icons")
