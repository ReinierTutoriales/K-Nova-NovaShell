[Icon Theme]
Name=NovaGlass
Comment=NovaShell layered vector icons
Inherits=NovaGlass-GoldenGate-light,NovaGlass-System-light,breeze,hicolor
Directories=scalable/apps,16x16/places,scalable/places,scalable/actions

[16x16/places]
Size=16
Type=Fixed
Context=Places

[scalable/places]
Size=64
MinSize=22
MaxSize=256
Type=Scalable
Context=Places

[scalable/apps]
Size=64
MinSize=16
MaxSize=256
Type=Scalable
Context=Applications

[scalable/actions]
Size=24
MinSize=16
MaxSize=64
Type=Scalable
Context=Actions
