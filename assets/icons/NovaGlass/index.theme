[Icon Theme]
Name=NovaGlass
Comment=NovaShell layered vector icons
Inherits=NovaGlass-System-light,breeze,hicolor
Directories=scalable/apps,scalable/actions

[scalable/apps]
Size=64
MinSize=16
MaxSize=256
Type=Scalable
Context=Applications

[scalable/actions]
Size=24
MinSize=16
MaxSize=64
Type=Scalable
Context=Actions
